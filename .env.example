# Server-only credentials. Never add VITE_ prefixes to private keys.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Optional direct URL for the same database. The framework can derive it.
DATABASE_URL_UNPOOLED=
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# Set only if the framework cannot infer the public origin.
BETTER_AUTH_URL=
GOOGLE_GENERATIVE_AI_API_KEY=replace-with-your-google-key
# Optional manual provider alternative; not automatic fallback.
OPENROUTER_API_KEY=
# Required in production while the documented scheduled sweep is enabled.
CRON_SECRET=replace-with-a-separate-long-random-secret
AGENT_NATIVE_VERCEL_CRON_SCHEDULE="0 9 * * *"
